# Application Port (AWS App Runner / Elastic Beanstalk / ECS will inject PORT or use 5000)
PORT=5000
NODE_ENV=production
JWT_SECRET=replace_with_a_secure_random_32_char_secret_key

# Database Configuration (AWS RDS MySQL or Local)
# For AWS RDS, DB_HOST is your RDS endpoint (e.g. retail-db.c0xyz.us-east-1.rds.amazonaws.com)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=retail_db

# SSL Configuration for AWS RDS
# Set to 'true' if RDS parameter group enforces require_secure_transport=ON
# Default in production is 'true' for remote hosts with rejectUnauthorized: false
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Connection Pool Settings
DB_CONNECTION_LIMIT=10

# CORS Allowed Origins (comma-separated for multiple origins, or * for all)
# Example: https://app.yourdomain.com,https://inventorypro.cloudfront.net
CORS_ORIGIN=*
