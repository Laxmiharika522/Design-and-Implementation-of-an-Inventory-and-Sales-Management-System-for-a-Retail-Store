{
  "name": "inventorypro-retail-system",
  "version": "1.0.0",
  "description": "Multi-portal retail inventory & sales management web application deployable to AWS",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix client",
    "build": "npm run build --prefix client",
    "start": "node server/src/index.js",
    "init-db": "npm run init-db --prefix server",
    "seed": "npm run seed --prefix server",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client"
  },
  "keywords": [
    "inventory",
    "pos",
    "mysql",
    "express",
    "react",
    "aws"
  ],
  "author": "",
  "license": "ISC"
}

